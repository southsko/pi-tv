{
  "web_port": 8080,
  "power_switch_mode": "toggle",
  "osd_rotate": 90,
  "osd_font_size": 36,
  "touch": {
    "enabled": true,
    "rotate": 90,
    "swipe_px": 80,
    "long_press_s": 0.8,
    "seek_step": 30,
    "overlay_s": 3.0,
    "gestures": {
      "tap": "overlay",
      "long_press": "power",
      "up": "channel_up",
      "down": "channel_down",
      "left": "seek_back",
      "right": "seek_fwd"
    }
  },
  "pins": {
    "power_button": 26,
    "channel_button": null,
    "backlight": 18,
    "audio_pwm": 19,
    "amp_enable": null
  },
  "mpv_args": [
    "--profile=fast",
    "--vo=gpu",
    "--gpu-context=drm",
    "--hwdec=v4l2m2m-copy",
    "--ao=alsa",
    "--panscan=1.0",
    "--video-rotate=90"
  ]
}