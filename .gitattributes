# Scripts and config consumed on Linux MUST keep LF endings, regardless of the
# checkout OS (CRLF breaks shebangs and JSON parsers on the Pi).
*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
# Windows-only helpers keep CRLF
*.ps1       text eol=crlf
